# ---------------------------------------------------------------------------
# LHC Builders — environment variables
# Copy this file to `.env.local` and fill in real values. Never commit .env.local
# ---------------------------------------------------------------------------

# Public site URL, used for canonical URLs, sitemap.xml and Open Graph tags.
# No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.lhcbuilders.com

# --- Contact form delivery (optional until a provider is chosen) -----------
# The contact form posts to /api/contact. That route only sends mail when BOTH
# of the variables below are set. Until then it returns a clear error and the
# form tells the visitor to call or email instead — it never fakes a success.
#
# Get an API key at https://resend.com (free tier covers a site this size).
RESEND_API_KEY=
# Inbox that should receive website enquiries.
CONTACT_TO_EMAIL=
# Verified sending address on your Resend domain, e.g. website@lhcbuilders.com
CONTACT_FROM_EMAIL=
